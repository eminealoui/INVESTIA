<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.image.Image?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.LoginController"
            styleClass="page">

    <!-- LEFT BRAND PANEL -->
    <left>
        <VBox spacing="22" styleClass="login-left" prefWidth="520">
            <padding>
                <Insets top="28" right="28" bottom="28" left="28"/>
            </padding>

            <HBox spacing="14" alignment="CENTER_LEFT">
                <ImageView fitHeight="55" fitWidth="55" preserveRatio="true" >
                    <image>
                        <Image url="@img/logo.png"/>
                    </image>
                </ImageView>

                <Label text="INVESTIA" styleClass="brandTitle"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Bienvenue" styleClass="heroTitle"/>
                <Label text="👋" styleClass="heroEmoji"/>
            </HBox>
            <Label
                    text="Nous sommes ravis de vous revoir sur la plateforme Investia."
                    wrapText="true"
                    maxWidth="420"
                    styleClass="heroSub"/>

            <HBox spacing="16">

                <!-- Sécurité -->
                <VBox spacing="10" styleClass="featureCard" prefWidth="240">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <SVGPath styleClass="featureIcon"
                                 content="M12 2C9.79 2 8 3.79 8 6V8H7C5.9 8 5 8.9 5 10V20C5 21.1 5.9 22 7 22H17C18.1 22 19 21.1 19 20V10C19 8.9 18.1 8 17 8H16V6C16 3.79 14.21 2 12 2ZM10 6C10 4.9 10.9 4 12 4C13.1 4 14 4.9 14 6V8H10V6Z"/>
                        <Label text="Sécurisé" styleClass="featureTitle"/>
                    </HBox>

                    <Label text="Authentification &amp; rôles."
                           wrapText="true"
                           styleClass="featureSub"/>

                    <Label text="Protection avancée des comptes, accès contrôlés et autorisations administrateur."
                           wrapText="true"
                           styleClass="featureSubSmall"/>
                </VBox>

                <!-- Suivi -->
                <VBox spacing="10" styleClass="featureCard" prefWidth="240">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <SVGPath styleClass="featureIcon"
                                 content="M4 19H20V21H2V3H4V19ZM6 17V10H8V17H6ZM10 17V6H12V17H10ZM14 17V12H16V17H14ZM18 17V8H20V17H18Z"/>
                        <Label text="Suivi" styleClass="featureTitle"/>
                    </HBox>

                    <Label text="Projets, événements, statuts."
                           wrapText="true"
                           styleClass="featureSub"/>

                    <Label text="Gestion centralisée et visibilité en temps réel sur l’activité et l’avancement."
                           wrapText="true"
                           styleClass="featureSubSmall"/>
                </VBox>

            </HBox>




            <Region VBox.vgrow="ALWAYS"/>

            <Label text="© Investia — Admin Panel" styleClass="footerText"/>
        </VBox>
    </left>

    <!-- RIGHT FORM PANEL -->
    <center>
        <StackPane styleClass="login-right">
            <VBox styleClass="login-card" spacing="14" maxWidth="420">
                <Label text="Connexion Admin" styleClass="formTitle"/>
                <Label text="Entrez vos identifiants pour accéder au dashboard." styleClass="formSub"/>

                <Label text="EMAIL" styleClass="fieldLabel"/>
                <TextField fx:id="emailField" promptText="ex: admin@mail.com" styleClass="input"/>

                <Label text="MOT DE PASSE" styleClass="fieldLabel"/>
                <PasswordField fx:id="passwordField" promptText="Votre mot de passe" styleClass="input"/>

                <HBox alignment="CENTER_RIGHT">
                    <Hyperlink text="Mot de passe oublié ?" onAction="#onForgotPassword" styleClass="link"/>
                </HBox>


                <Label fx:id="msgLabel" text="" styleClass="error"/>

                <Button text="Se connecter" onAction="#onLogin" styleClass="btnPrimarySmall"/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
